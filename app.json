{
  "expo": {
    "name": "Qui a dit ?",
    "slug": "qui-a-dit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "backgroundColor": "#F6C8D5",
    "scheme": "quiadit",
    "userInterfaceStyle": "light",
    "ios": {
      "backgroundColor": "#F6C8D5",
      "bundleIdentifier": "com.poupsipoups.qui-a-dit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6C8D5",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Qui a dit ? accède à tes photos pour créer les joueurs.",
          "cameraPermission": "Qui a dit ? accède à l’appareil photo pour créer les joueurs.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6C8D5",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
